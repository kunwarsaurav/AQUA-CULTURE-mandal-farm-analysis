    "def clean_data(df):\n",
    "    df= df.copy()\n",
    "\n",
    "\n",
    "df['Date'] = pd.to_datetime(df['Date'])\n",
    "\n",
    "df.dtypes"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "7e084a1a",
   "metadata": {},
   "source": [
    "## fill missing numeric columns with median per pond"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 52,
   "id": "0f3d3376",
   "metadata": {},
   "outputs": [],
   "source": [
    "num_cols = ['Water_Temp_C', 'pH_Level','Ammonia_ppm','Dissolved_Oxygen_mgL','Daily_Feed_kg','Est_Avg_Weight_g']\n",
    "\n",
    "\n",
    "for col in num_cols:\n",
    "    df[col] = df.groupby('Pond_ID')[col].transform(\n",
    "        lambda x: x.fillna(x.median())\n",
    "    )\n",
    "\n"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "56300a5a",
   "metadata": {},
   "source": [
    "## Cap outliers using IQR per pond"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 53,
   "id": "8128e9d8",
   "metadata": {},
   "outputs": [],
   "source": [
    "def cap_outliers(series):\n",
    "    Q1, Q3 = series.quantile(0.25), series.quantile(0.75)\n",
    "    IQR = Q3-Q1\n",
    "    return series.clip(Q1 - 1.5*IQR, Q3+ 1.5*IQR)\n",
    "\n",
    "\n",
    "for col in ['Mortality_Count', 'Ammonia_ppm','Dissolved_Oxygen_mgL']:\n",
    "    df[col] = df.groupby('Pond_ID')[col].transform(cap_outliers)\n",
    "\n",
    "\n",
    "\n"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "c455e364",
   "metadata": {},
   "source": [
    "## fix negative profits to 0 where fish_counts = 0 (pond empty)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 54,
   "id": "2d0c12ca",
   "metadata": {},
   "outputs": [],
   "source": [
    "df.loc[df['Fish_Count'] == 0, 'Daily_Profit_Loss_NPR'] = 0\n",
    "\n"
   ]
  },
